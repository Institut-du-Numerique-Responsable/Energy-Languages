      >>SOURCE FORMAT FREE
*> The Computer Language Benchmarks Game: fasta
*> COBOL (GnuCOBOL) port by the Institut du Numerique Responsable.
*> Cumulative probabilities are the integer thresholds of the C program
*> fasta.gcc-2: 1 + (uint32_t)(cumulative_float * IM), precomputed in
*> single precision, so the generator uses integer arithmetic only.
IDENTIFICATION DIVISION.
PROGRAM-ID. fasta.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 ARG-TEXT          PIC X(20).
01 N                 PIC S9(12) COMP-5.
01 TOTAL             PIC S9(12) COMP-5.
01 REMAINING         PIC S9(12) COMP-5.
01 LINE-LEN          PIC S9(4) COMP-5.
01 COL-IDX               PIC S9(4) COMP-5.
01 K                 PIC S9(4) COMP-5.
01 ALU-POS               PIC S9(4) COMP-5.
01 SEED              PIC S9(12) COMP-5 VALUE 42.
01 PRODUCT           PIC S9(12) COMP-5.
01 QUOTIENT          PIC S9(12) COMP-5.
01 IM                PIC S9(9) COMP-5 VALUE 139968.
01 IA                PIC S9(9) COMP-5 VALUE 3877.
01 IC                PIC S9(9) COMP-5 VALUE 29573.
01 NUCL-COUNT        PIC S9(4) COMP-5.
01 LINE-BUF          PIC X(60).
01 ALU-TEXT.
   05 FILLER PIC X(72) VALUE
      "GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGGGAGGCCGAGGCGGGCGGATCACCTGAGGTC".
   05 FILLER PIC X(72) VALUE
      "AGGAGTTCGAGACCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAATACAAAAATTAGCCGGGCG".
   05 FILLER PIC X(72) VALUE
      "TGGTGGCGCGCGCCTGTAATCCCAGCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGGAGGCGG".
   05 FILLER PIC X(71) VALUE
      "AGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCCAGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA".
01 ALU-CHARS REDEFINES ALU-TEXT.
   05 ALU-CHAR       PIC X OCCURS 287 TIMES.
01 ALU-LEN           PIC S9(4) COMP-5 VALUE 287.
01 IUB-LETTERS       PIC X(15) VALUE "acgtBDHKMNRSVWY".
01 IUB-THRESHOLDS.
   05 FILLER PIC S9(9) COMP-5 VALUE 37792.
   05 FILLER PIC S9(9) COMP-5 VALUE 54588.
   05 FILLER PIC S9(9) COMP-5 VALUE 71384.
   05 FILLER PIC S9(9) COMP-5 VALUE 109176.
   05 FILLER PIC S9(9) COMP-5 VALUE 111975.
   05 FILLER PIC S9(9) COMP-5 VALUE 114774.
   05 FILLER PIC S9(9) COMP-5 VALUE 117574.
   05 FILLER PIC S9(9) COMP-5 VALUE 120373.
   05 FILLER PIC S9(9) COMP-5 VALUE 123172.
   05 FILLER PIC S9(9) COMP-5 VALUE 125972.
   05 FILLER PIC S9(9) COMP-5 VALUE 128771.
   05 FILLER PIC S9(9) COMP-5 VALUE 131570.
   05 FILLER PIC S9(9) COMP-5 VALUE 134370.
   05 FILLER PIC S9(9) COMP-5 VALUE 137169.
   05 FILLER PIC S9(9) COMP-5 VALUE 139968.
01 IUB-TABLE REDEFINES IUB-THRESHOLDS.
   05 IUB-P          PIC S9(9) COMP-5 OCCURS 15 TIMES.
01 HS-LETTERS        PIC X(4) VALUE "acgt".
01 HS-THRESHOLDS.
   05 FILLER PIC S9(9) COMP-5 VALUE 42404.
   05 FILLER PIC S9(9) COMP-5 VALUE 70117.
   05 FILLER PIC S9(9) COMP-5 VALUE 97767.
   05 FILLER PIC S9(9) COMP-5 VALUE 139969.
01 HS-TABLE REDEFINES HS-THRESHOLDS.
   05 HS-P           PIC S9(9) COMP-5 OCCURS 4 TIMES.
01 CUR-COUNT         PIC S9(4) COMP-5.
01 CUR-LETTERS       PIC X(15).
01 CUR-TABLE.
   05 CUR-P          PIC S9(9) COMP-5 OCCURS 15 TIMES.

PROCEDURE DIVISION.
MAIN-PARA.
    ACCEPT ARG-TEXT FROM ARGUMENT-VALUE
    MOVE 1000 TO N
    IF ARG-TEXT NOT = SPACES
        COMPUTE N = FUNCTION NUMVAL(ARG-TEXT)
    END-IF
    DISPLAY ">ONE Homo sapiens alu"
    COMPUTE TOTAL = 2 * N
    PERFORM REPEAT-ALU
    DISPLAY ">TWO IUB ambiguity codes"
    MOVE 15 TO CUR-COUNT
    MOVE IUB-LETTERS TO CUR-LETTERS
    MOVE IUB-TABLE TO CUR-TABLE
    COMPUTE TOTAL = 3 * N
    PERFORM RANDOM-SEQUENCE
    DISPLAY ">THREE Homo sapiens frequency"
    MOVE 4 TO CUR-COUNT
    MOVE HS-LETTERS TO CUR-LETTERS
    MOVE HS-TABLE TO CUR-TABLE
    COMPUTE TOTAL = 5 * N
    PERFORM RANDOM-SEQUENCE
    STOP RUN.

REPEAT-ALU.
    MOVE 1 TO ALU-POS
    MOVE TOTAL TO REMAINING
    PERFORM UNTIL REMAINING <= 0
        MOVE 60 TO LINE-LEN
        IF REMAINING < 60
            MOVE REMAINING TO LINE-LEN
        END-IF
        PERFORM VARYING COL-IDX FROM 1 BY 1 UNTIL COL-IDX > LINE-LEN
            MOVE ALU-CHAR(ALU-POS) TO LINE-BUF(COL-IDX:1)
            ADD 1 TO ALU-POS
            IF ALU-POS > ALU-LEN
                MOVE 1 TO ALU-POS
            END-IF
        END-PERFORM
        DISPLAY LINE-BUF(1:LINE-LEN)
        SUBTRACT LINE-LEN FROM REMAINING
    END-PERFORM.

RANDOM-SEQUENCE.
    MOVE TOTAL TO REMAINING
    PERFORM UNTIL REMAINING <= 0
        MOVE 60 TO LINE-LEN
        IF REMAINING < 60
            MOVE REMAINING TO LINE-LEN
        END-IF
        PERFORM VARYING COL-IDX FROM 1 BY 1 UNTIL COL-IDX > LINE-LEN
            COMPUTE PRODUCT = SEED * IA + IC
            DIVIDE PRODUCT BY IM GIVING QUOTIENT
            COMPUTE SEED = PRODUCT - QUOTIENT * IM
            MOVE 1 TO NUCL-COUNT
            PERFORM VARYING K FROM 1 BY 1 UNTIL K > CUR-COUNT
                IF CUR-P(K) <= SEED
                    ADD 1 TO NUCL-COUNT
                END-IF
            END-PERFORM
            MOVE CUR-LETTERS(NUCL-COUNT:1) TO LINE-BUF(COL-IDX:1)
        END-PERFORM
        DISPLAY LINE-BUF(1:LINE-LEN)
        SUBTRACT LINE-LEN FROM REMAINING
    END-PERFORM.
