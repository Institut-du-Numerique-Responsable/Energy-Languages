      >>SOURCE FORMAT FREE
*> The Computer Language Benchmarks Game: n-body
*> COBOL (GnuCOBOL) port by the Institut du Numerique Responsable,
*> following the reference algorithm of the Python and C programs.
IDENTIFICATION DIVISION.
PROGRAM-ID. nbody.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 ARG-TEXT          PIC X(20).
01 STEPS             PIC 9(10) COMP-5.
01 STEP              PIC 9(10) COMP-5.
01 I                 PIC 9(4) COMP-5.
01 J                 PIC 9(4) COMP-5.
01 PI-VALUE          COMP-2 VALUE 3.141592653589793.
01 SOLAR-MASS        COMP-2.
01 DAYS-PER-YEAR     COMP-2 VALUE 365.24.
01 DT                COMP-2 VALUE 0.01.
01 BODIES.
   05 BODY OCCURS 5 TIMES.
      10 PX          COMP-2.
      10 PY          COMP-2.
      10 PZ          COMP-2.
      10 VX          COMP-2.
      10 VY          COMP-2.
      10 VZ          COMP-2.
      10 MASS        COMP-2.
01 DX                COMP-2.
01 DY                COMP-2.
01 DZ                COMP-2.
01 D2                COMP-2.
01 MAG               COMP-2.
01 MI                COMP-2.
01 MJ                COMP-2.
01 ENERGY            COMP-2.
01 MOM-X             COMP-2.
01 MOM-Y             COMP-2.
01 MOM-Z             COMP-2.
01 ENERGY-OUT        PIC -9.9(9).

PROCEDURE DIVISION.
MAIN-PARA.
    ACCEPT ARG-TEXT FROM ARGUMENT-VALUE
    MOVE 1000 TO STEPS
    IF ARG-TEXT NOT = SPACES
        COMPUTE STEPS = FUNCTION NUMVAL(ARG-TEXT)
    END-IF
    PERFORM INIT-BODIES
    PERFORM OFFSET-MOMENTUM
    PERFORM REPORT-ENERGY
    PERFORM VARYING STEP FROM 1 BY 1 UNTIL STEP > STEPS
        PERFORM ADVANCE
    END-PERFORM
    PERFORM REPORT-ENERGY
    STOP RUN.

INIT-BODIES.
    COMPUTE SOLAR-MASS = 4 * PI-VALUE * PI-VALUE
    *> Sun
    MOVE 0 TO PX(1) PY(1) PZ(1) VX(1) VY(1) VZ(1)
    MOVE SOLAR-MASS TO MASS(1)
    *> Jupiter
    MOVE 4.84143144246472090E+00  TO PX(2)
    MOVE -1.16032004402742839E+00 TO PY(2)
    MOVE -1.03622044471123109E-01 TO PZ(2)
    COMPUTE VX(2) = 1.66007664274403694E-03 * DAYS-PER-YEAR
    COMPUTE VY(2) = 7.69901118419740425E-03 * DAYS-PER-YEAR
    COMPUTE VZ(2) = -6.90460016972063023E-05 * DAYS-PER-YEAR
    COMPUTE MASS(2) = 9.54791938424326609E-04 * SOLAR-MASS
    *> Saturn
    MOVE 8.34336671824457987E+00  TO PX(3)
    MOVE 4.12479856412430479E+00  TO PY(3)
    MOVE -4.03523417114321381E-01 TO PZ(3)
    COMPUTE VX(3) = -2.76742510726862411E-03 * DAYS-PER-YEAR
    COMPUTE VY(3) = 4.99852801234917238E-03 * DAYS-PER-YEAR
    COMPUTE VZ(3) = 2.30417297573763929E-05 * DAYS-PER-YEAR
    COMPUTE MASS(3) = 2.85885980666130812E-04 * SOLAR-MASS
    *> Uranus
    MOVE 1.28943695621391310E+01  TO PX(4)
    MOVE -1.51111514016986312E+01 TO PY(4)
    MOVE -2.23307578892655734E-01 TO PZ(4)
    COMPUTE VX(4) = 2.96460137564761618E-03 * DAYS-PER-YEAR
    COMPUTE VY(4) = 2.37847173959480950E-03 * DAYS-PER-YEAR
    COMPUTE VZ(4) = -2.96589568540237556E-05 * DAYS-PER-YEAR
    COMPUTE MASS(4) = 4.36624404335156298E-05 * SOLAR-MASS
    *> Neptune
    MOVE 1.53796971148509165E+01  TO PX(5)
    MOVE -2.59193146099879641E+01 TO PY(5)
    MOVE 1.79258772950371181E-01  TO PZ(5)
    COMPUTE VX(5) = 2.68067772490389322E-03 * DAYS-PER-YEAR
    COMPUTE VY(5) = 1.62824170038242295E-03 * DAYS-PER-YEAR
    COMPUTE VZ(5) = -9.51592254519715870E-05 * DAYS-PER-YEAR
    COMPUTE MASS(5) = 5.15138902046611451E-05 * SOLAR-MASS.

OFFSET-MOMENTUM.
    MOVE 0 TO MOM-X MOM-Y MOM-Z
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 5
        COMPUTE MOM-X = MOM-X - VX(I) * MASS(I)
        COMPUTE MOM-Y = MOM-Y - VY(I) * MASS(I)
        COMPUTE MOM-Z = MOM-Z - VZ(I) * MASS(I)
    END-PERFORM
    COMPUTE VX(1) = MOM-X / MASS(1)
    COMPUTE VY(1) = MOM-Y / MASS(1)
    COMPUTE VZ(1) = MOM-Z / MASS(1).

ADVANCE.
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 4
        PERFORM VARYING J FROM I BY 1 UNTIL J > 5
            IF J > I
                COMPUTE DX = PX(I) - PX(J)
                COMPUTE DY = PY(I) - PY(J)
                COMPUTE DZ = PZ(I) - PZ(J)
                COMPUTE D2 = DX * DX + DY * DY + DZ * DZ
                COMPUTE MAG = DT / (D2 * FUNCTION SQRT(D2))
                COMPUTE MI = MASS(I) * MAG
                COMPUTE MJ = MASS(J) * MAG
                COMPUTE VX(I) = VX(I) - DX * MJ
                COMPUTE VY(I) = VY(I) - DY * MJ
                COMPUTE VZ(I) = VZ(I) - DZ * MJ
                COMPUTE VX(J) = VX(J) + DX * MI
                COMPUTE VY(J) = VY(J) + DY * MI
                COMPUTE VZ(J) = VZ(J) + DZ * MI
            END-IF
        END-PERFORM
    END-PERFORM
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 5
        COMPUTE PX(I) = PX(I) + DT * VX(I)
        COMPUTE PY(I) = PY(I) + DT * VY(I)
        COMPUTE PZ(I) = PZ(I) + DT * VZ(I)
    END-PERFORM.

REPORT-ENERGY.
    MOVE 0 TO ENERGY
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 5
        COMPUTE ENERGY = ENERGY + MASS(I) *
            (VX(I) * VX(I) + VY(I) * VY(I) + VZ(I) * VZ(I)) / 2
        PERFORM VARYING J FROM I BY 1 UNTIL J > 5
            IF J > I
                COMPUTE DX = PX(I) - PX(J)
                COMPUTE DY = PY(I) - PY(J)
                COMPUTE DZ = PZ(I) - PZ(J)
                COMPUTE ENERGY = ENERGY - MASS(I) * MASS(J) /
                    FUNCTION SQRT(DX * DX + DY * DY + DZ * DZ)
            END-IF
        END-PERFORM
    END-PERFORM
    COMPUTE ENERGY-OUT ROUNDED = ENERGY
    DISPLAY FUNCTION TRIM(ENERGY-OUT).
